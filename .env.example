# Empire OS — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is NEVER committed to git.

# ── Server ──────────────────────────────────────────────────────────────────
# 4000, not 3001: Boss Listers uses 3001.
PORT=4000
HOST=localhost

# The server reads apps/empire-os-server/.env (it runs from that folder), so put these there.
# Key for every endpoint except /health (blank = auth off, only for your own machine).
# Generate one: openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then enter the same key once in the dashboard (the "Empire key" bar).
EMPIRE_API_KEY=
# With a key set, the browser origins allowed to call the server (comma-separated).
# Blank = the CrossPost dashboard: http://localhost:3000,http://127.0.0.1:3000
EMPIRE_ALLOWED_ORIGINS=

# Directory to store persistent data (memory, events, workflow state)
DATA_DIR=.empire-data

# ── Connected apps ───────────────────────────────────────────────────────────
# Bookmaker book studio (StoryForge module, proxied at /storyforge/*).
# Leave blank for the default http://localhost:3010.
STORYFORGE_BASE_URL=

# Boss Listers reseller app (proxied at /bosslisters/*). Leave blank for http://localhost:3001.
BOSSLISTERS_BASE_URL=
# Same value as EMPIRE_SHARED_KEY in Boss Listers. Without it only health works.
BOSSLISTERS_EMPIRE_KEY=

# ── AI Providers ─────────────────────────────────────────────────────────────
#
# PROVIDER ROUTING (default strategy: cost)
#   Ollama  → local/routine: copy, summary, classification  (free, no key)
#   Claude  → code, architecture, complex reasoning
#   Gemini  → research, long-context planning, scripts
#   OpenAI  → GPT-specific features
#   Goose   → local dev agent: file ops, shell, coding execution (no key)
#
# You can run with ONLY Ollama locally and zero cloud keys.

# Ollama — local inference, auto-detected (no key needed)
# Default base URL — change only if Ollama runs on a different port
OLLAMA_BASE_URL=http://localhost:11434

# Goose — local dev agent (Block's Goose CLI), auto-detected
# If Empire OS says "Goose not found", run FIND_AND_FIX_GOOSE.bat and paste the path here
# Example: GOOSE_BIN=C:\Users\jjard\.local\bin\goose.exe
GOOSE_BIN=

# Anthropic Claude — code, architecture, complex reasoning
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — research, long-context planning, scripts
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI — GPT-specific features
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Video Pipeline ───────────────────────────────────────────────────────────
# Only needed if you wire up the Video Pipeline module
# PEXELS_API_KEY=
# ELEVEN_LABS_API_KEY=
