# Empire OS — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is NEVER committed to git.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=localhost

# API key for all empire-os endpoints (leave blank to disable auth in dev)
# Generate a strong key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMPIRE_API_KEY=

# Directory to store persistent data (memory, events, workflow state)
DATA_DIR=.empire-data

# ── AI Providers (add at least one) ─────────────────────────────────────────

# Anthropic Claude — primary AI for code, architecture, agent chat
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — preferred for research and script generation
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI (optional — for copy tasks)
# OPENAI_API_KEY=

# ── Video Pipeline ───────────────────────────────────────────────────────────
# Only needed if you wire up the Video Pipeline module
# PEXELS_API_KEY=
# ELEVEN_LABS_API_KEY=
